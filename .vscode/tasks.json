{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build PrivateCall Browser Debug APK",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"assembleDebug"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Inspect Android SDK",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"echo \"ANDROID_HOME=$ANDROID_HOME\"; echo \"ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT\"; ls -la /opt 2>/dev/null; ls -la /tmp/android-sdk 2>/dev/null"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Inspect Android SDK Packages",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"find /tmp/android-sdk/build-tools -maxdepth 1 -mindepth 1 -type d -printf '%f\\n'; find /tmp/android-sdk/platforms -maxdepth 1 -mindepth 1 -type d -printf '%f\\n'; find /tmp/android-sdk/cmdline-tools -maxdepth 2 -type f -name sdkmanager -printf '%p\\n'"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Diagnose Android Build",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"assembleDebug",
				"--stacktrace"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Inspect Java Installations",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"java -version 2>&1; ls -la /usr/lib/jvm 2>/dev/null"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Find JDK 17",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"find / -maxdepth 4 -type f -name java 2>/dev/null | sort | head -30"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Find Java Paths",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"which -a java; readlink -f \"$(which java)\""
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Install JDK 17",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"source /usr/local/sdkman/bin/sdkman-init.sh && sdk install java 17.0.16-ms"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Check Phase 1 Changes",
			"type": "shell",
			"command": "git",
			"args": [
				"--no-pager",
				"status",
				"--short"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Run PrivateCall Unit Tests",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"testDebugUnitTest"
			],
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Run Complete Unit Tests",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"testDebugUnitTest"
			],
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "Build Updated Debug APK",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"assembleDebug",
				"testDebugUnitTest"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Validate Android project",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"testDebugUnitTest",
				"assembleDebug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Diagnose Android build",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"assembleDebug",
				"--stacktrace"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Locate JDK installations",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"ls -1 /usr/local/sdkman/candidates/java 2>/dev/null || true"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate Android with JDK21",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"export JAVA_HOME=/usr/local/sdkman/candidates/java/21.0.13.0+2-ms; export PATH=\"$JAVA_HOME/bin:$PATH\"; ./gradlew testDebugUnitTest assembleDebug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Locate Android SDK",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"for p in /opt/android-sdk /opt/android-sdk-linux /usr/local/lib/android/sdk /workspaces/android-sdk /root/Android/Sdk; do [ -d \"$p\" ] && echo \"$p\"; done"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build debug APK",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"assembleDebug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run unit tests",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"testDebugUnitTest"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Build voice effects APK",
			"type": "shell",
			"command": "./gradlew",
			"args": [
				"assembleDebug",
				"--stacktrace"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Inspect Java and Android SDK",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"printf 'JAVA_HOME=%s\\njava=' \"$JAVA_HOME\"; java -version 2>&1 || true; printf 'SDK=%s\\nANDROID_HOME=%s\\nANDROID_SDK_ROOT=%s\\n' \"$SDK\" \"$ANDROID_HOME\" \"$ANDROID_SDK_ROOT\""
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "List Java installations",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"ls -1 /usr/local/sdkman/candidates/java 2>/dev/null || true; ls -1 /usr/lib/jvm 2>/dev/null || true"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build APK with JDK 21",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"export JAVA_HOME=/usr/local/sdkman/candidates/java/21.0.13.0+2-ms; export PATH=\"$JAVA_HOME/bin:$PATH\"; ./gradlew assembleDebug"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find Android SDK",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"for p in \"$ANDROID_HOME\" \"$ANDROID_SDK_ROOT\" /opt/android-sdk /opt/android-sdk-linux /home/codespace/.android/sdk /home/codespace/Android/Sdk /usr/lib/android-sdk /usr/local/android-sdk; do [ -n \"$p\" ] && [ -d \"$p\" ] && echo \"$p\"; done; find /home/codespace /opt /usr/local -maxdepth 4 -type d -name 'platforms' 2>/dev/null | head -20"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Android tooling",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"command -v sdkmanager || true; command -v avdmanager || true; ls -la /usr/lib/android-sdk 2>/dev/null || true; ls -la /opt/android-sdk 2>/dev/null || true"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Android SDK tooling",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"apt-get update && apt-get install -y android-sdk"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Download Android SDK",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"mkdir -p \"$PWD/.android-sdk/cmdline-tools\" && curl -L --fail --retry 3 -o /tmp/android-commandline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && unzip -q -o /tmp/android-commandline-tools.zip -d \"$PWD/.android-sdk/cmdline-tools\" && mv \"$PWD/.android-sdk/cmdline-tools/cmdline-tools\" \"$PWD/.android-sdk/cmdline-tools/latest\" && yes | \"$PWD/.android-sdk/cmdline-tools/latest/bin/sdkmanager\" --sdk_root=\"$PWD/.android-sdk\" \"platform-tools\" \"platforms;android-35\" \"build-tools;35.0.0\""
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}